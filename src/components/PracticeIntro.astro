---
import { projects, media } from '../data/projects';
import '../styles/practice-intro.css';
const base = import.meta.env.BASE_URL;
const asset = (path: string) => base + path.replace(/^\//, '');
// Figures repeat the About page; architects come from the credits on project pages.
const facts = [
  { value: 70, suffix: '+', label: 'Completed projects' },
  { text: 'AB + BC', label: 'Landscape architecture licensing' },
  { value: 40, suffix: '+', label: 'Years of leadership experience' },
  { value: 10, suffix: '+', label: 'Years in practice' },
];
const credits = projects.map(project => project.credit?.replace(/^Architecture by /, '')).filter((name): name is string => !!name);
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
// A firm's own logo appears once its file is added at src/assets/logos/<slug>.(svg|png|jpg|webp)
// (with the firm's permission); until then the name is set as a plain wordmark.
const logoFiles = import.meta.glob<string>('../assets/logos/*.{svg,png,jpg,jpeg,webp}', { eager: true, query: '?url', import: 'default' });
const logoFor = (name: string) => Object.entries(logoFiles).find(([file]) => file.replace(/^.*\/|\.[a-z]+$/g, '') === slug(name))?.[1];
const architects = [...new Set(credits)]
  .sort((a, b) => credits.filter(name => name === b).length - credits.filter(name => name === a).length || a.localeCompare(b))
  .map(name => {
    const count = credits.filter(item => item === name).length;
    return { name, logo: logoFor(name), count };
  });
const statement = 'Pi Design Group designs the outdoor spaces that connect homes, businesses and communities.'.split(' ');
---
<section id="about" class="practice-intro frame" aria-labelledby="practice-title">
  <div class="practice-top">
    <div class="practice-opening">
      <p class="practice-label">About Pi Design Group</p>
      <h2 id="practice-title"><span class="practice-title-line">A Calgary-Based<span class="practice-title-photo" aria-hidden="true"><img src={asset(media.services.multifamily)} alt="" width="1600" height="1067" loading="lazy" decoding="async" /></span></span><br />Landscape Practice.</h2>
    </div>
    <div class="practice-copy">
      <p class="practice-statement" data-practice-statement>{statement.map(word => <span>{word} </span>)}</p>
      <p>Our work brings planting, pedestrian routes and places to gather into one considered landscape. We explore the whole site through its plans, then carry that thinking into the paths, materials and planted edges people experience every day.</p>
    </div>
  </div>

  <dl class="practice-facts-strip">
    {facts.map(fact => <div><dt class:list={{ 'is-text': !fact.value }}>{fact.value ? <><span data-count={fact.value}>{fact.value}</span>{fact.suffix}</> : fact.text}</dt><dd>{fact.label}</dd></div>)}
  </dl>

  <div class="practice-collaborators">
    <p>Project architects we have worked with</p>
    <div class="practice-logo-band" data-logo-band>
      {[0, 1].map(copy => <ul class="practice-logo-track" aria-hidden={copy === 1 ? 'true' : undefined}>
        {architects.map(architect => <li class="practice-logo">
          {architect.logo
            ? <><span class="practice-logo-image"><img src={architect.logo} alt={architect.name} loading="lazy" decoding="async" /></span><span class="practice-logo-caption" aria-hidden="true">{architect.name}</span></>
            : <span class="practice-logo-mark"><span class="practice-logo-name">{architect.name}</span><span class="practice-logo-kind">Architecture</span></span>}
        </li>)}
      </ul>)}
    </div>
  </div>
</section>
<script>import '../scripts/practice-intro';</script>
