<script is:inline>
  (() => {
    const root = document.documentElement;
    let choice = 'system';
    try { choice = localStorage.getItem('pi-motion') || 'system'; } catch {}
    root.dataset.motion = choice === 'off' ? 'off' : choice === 'reduced' || matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduced' : 'full';
    document.addEventListener('click', event => {
      if (event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || root.dataset.motion !== 'full') return;
      const link = event.target.closest('a[data-project-card]');
      const img = link?.querySelector('img');
      if (!img) return;
      img.style.viewTransitionName = 'project-photo';
      try { sessionStorage.setItem('pi-photo-transition', JSON.stringify({ path: new URL(link.href).pathname.replace(/\/$/, ''), id: link.dataset.projectCard })); } catch {}
    });
    window.addEventListener('pagereveal', event => {
      let entry;
      try {
        const stored = sessionStorage.getItem('pi-photo-transition');
        sessionStorage.removeItem('pi-photo-transition');
        entry = JSON.parse(stored || 'null');
      } catch {}
      if (!event.viewTransition) return;
      if (root.dataset.motion !== 'full') { event.viewTransition.skipTransition(); return; }
      const img = document.querySelector('[data-primary-project]');
      // A restored page may show a later carousel image. Only its original
      // opening image represents the photograph used by the project card.
      const isOpeningImage = img?.closest('[data-gallery-index]')?.dataset.galleryIndex === '0';
      if (entry && img && isOpeningImage && entry.path === location.pathname.replace(/\/$/, '') && entry.id === img.dataset.primaryProject) img.style.viewTransitionName = 'project-photo';
      event.viewTransition.finished.finally(() => document.querySelectorAll('[style*="view-transition-name"]').forEach(el => el.style.removeProperty('view-transition-name')));
    });
    window.addEventListener('pageswap', event => {
      if (!event.viewTransition) return;
      if (root.dataset.motion !== 'full') event.viewTransition.skipTransition();
      event.viewTransition.finished.finally(() => document.querySelectorAll('[style*="view-transition-name"]').forEach(el => el.style.removeProperty('view-transition-name')));
    });
  })();
</script>
