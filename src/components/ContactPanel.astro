---
import { ArrowUpRight, ArrowRight, Mail, Phone } from '@lucide/astro';
import { media } from '../data/projects';
import '../styles/contact-footer.css';
const asset = (path:string) => import.meta.env.BASE_URL + path.replace(/^\//, '');
---
<section id="contact" class="contact contact-section frame" aria-labelledby="contact-title" tabindex="-1">
  <div class="contact-panel" data-reveal>
    <img class="contact-panel-image" src={asset(media.contact)} alt="" width="1920" height="1280" loading="lazy" decoding="async" />
    <div class="contact-panel-shade" aria-hidden="true"></div>
    <div class="contact-panel-content">
      <div class="contact-invitation">
        <h2 id="contact-title">Discuss Your<br />Next Project.</h2>
        <p>Tell us about the place you’re planning.</p>
        <a class="contact-start" href={import.meta.env.BASE_URL + 'contact'}><span>Get in Touch</span><ArrowUpRight size={25} stroke-width={1.4} aria-hidden="true" /></a>
      </div>
      <div class="contact-direct">
        <a href="mailto:peter@pidesigngroup.ca"><span><small><Mail size={16} stroke-width={1.6} aria-hidden="true" />Email Us</small><span>peter@pidesigngroup.ca</span></span><ArrowRight size={23} stroke-width={1.4} aria-hidden="true" /></a>
        <a href="tel:+14035104071"><span><small><Phone size={16} stroke-width={1.6} aria-hidden="true" />Call Us</small><span>403-510-4071</span></span><ArrowRight size={23} stroke-width={1.4} aria-hidden="true" /></a>
      </div>
    </div>
  </div>
</section>
<script>import '../scripts/contact-motion';</script>
