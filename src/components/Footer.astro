---
import { ArrowUp, ArrowUpRight } from '@lucide/astro';
import '../styles/contact-footer.css';
const { homepage = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const link = (id: string) => `${homepage ? '' : base}#${id}`;
---
<footer class="footer frame site-footer">
  <div class="footer-top">
    <div class="footer-identity"><a href={link('hero')} class="footer-wordmark" aria-label="Pi Design Group, home">Pi Design Group</a><p>Landscape architecture.</p></div>
    <nav aria-label="Footer">
      <a href={link('why')}>Design <ArrowUpRight size={18} stroke-width={1.3} aria-hidden="true" /></a>
      <a href={link('projects')}>Projects <ArrowUpRight size={18} stroke-width={1.3} aria-hidden="true" /></a>
      <a href={link('services')}>Services <ArrowUpRight size={18} stroke-width={1.3} aria-hidden="true" /></a>
      <a href={base + 'contact'}>Contact <ArrowUpRight size={18} stroke-width={1.3} aria-hidden="true" /></a>
    </nav>
    <a class="footer-return" href={homepage ? '#hero' : '#main'} aria-label="Back to top"><ArrowUp size={22} stroke-width={1.3} aria-hidden="true" /><span>Back to Top</span></a>
  </div>
  <div class="footer-bottom">
    <small>© {new Date().getFullYear()} Pi Design Group.</small>
    <label class="motion-setting js-only" for="motion-choice"><span>Motion</span><select id="motion-choice"><option value="system">System</option><option value="reduced">Reduced</option><option value="off">Off</option></select></label>
  </div>
</footer>
