---
import { ArrowLeft, ArrowRight, Pause, Play } from '@lucide/astro';
import { media, projects, projectPath } from '../data/projects';
import '../styles/featured-project.css';
const base = import.meta.env.BASE_URL;
const asset = (src: string) => base + src.replace(/^\//, '');
const views = [
  { id: 'crestmont-west', image: media.featured, alt: 'Shared courtyard with timber seating and planting at Crestmont West', detail: media.featuredDetail, detailAlt: 'Grasses and flowering planting at Crestmont West', copy: 'A planted courtyard connects the homes with timber seating, a shared play area, and paths for everyday use.' },
  { id: 'darcy', image: '/media/gallery/darcy/usb-img_2484.webp', alt: 'Front gardens and planted sidewalks at D’Arcy', detail: '/media/gallery/darcy/usb-img_2490.webp', detailAlt: 'Layered grasses and low planting beside the D’Arcy sidewalk', copy: 'Front gardens, flowering planting and shaded sidewalks connect individual homes to the neighbourhood.' },
  { id: 'seton-crossing', image: '/media/gallery/seton-crossing/2.webp', alt: 'The pergola and outdoor seating at Seton Crossing', detail: '/media/gallery/seton-crossing/usb-img_2443.webp', detailAlt: 'A planted pedestrian entrance at Seton Crossing', copy: 'Trees, grasses and places to sit bring a quieter pedestrian setting to the commercial plaza.' },
].map(view => {
  const project = projects.find(project => project.id === view.id)!;
  return { ...view, label: project.name, location: project.location || project.type, href: projectPath(project, base), image: asset(view.image), detail: asset(view.detail) };
});
const first = views[0];
---
<section id="featured" class="featured" aria-labelledby="featured-title">
  <div class="featured-atmosphere" aria-hidden="true"><img data-featured-background src={first.image} alt="" width="1920" height="1280" loading="lazy" decoding="async" /></div>
  <div class="frame featured-inner">
    <div class="featured-heading"><h2 id="featured-title">Featured Projects</h2>
      <div class="featured-controls js-only">
        <div class="featured-views" role="tablist" aria-label="Choose a featured project">
          {views.map((view, index) => <button type="button" role="tab" id={'featured-tab-' + view.id} aria-controls="featured-perspective" aria-selected={index === 0} tabindex={index === 0 ? 0 : -1} data-featured-view={view.id}><span class="featured-step" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span class="sr-only">{view.label}</span></button>)}
        </div>
        <div class="featured-paging" role="group" aria-label="Featured project slideshow">
          <button type="button" data-featured-autoplay-toggle aria-label="Pause automatic featured projects" aria-controls="featured-perspective"><Pause class="featured-pause-icon" size={17} stroke-width={1.4} /><Play class="featured-play-icon" size={17} stroke-width={1.4} /></button>
          <button type="button" data-featured-previous aria-label="Previous featured project"><ArrowLeft size={23} stroke-width={1.3} /></button>
          <button type="button" data-featured-next aria-label="Next featured project"><ArrowRight size={23} stroke-width={1.3} /></button>
        </div>
      </div>
    </div>
    <div class="featured-presentation" data-reveal>
      <div class="featured-card" id="featured-perspective" role="tabpanel" aria-labelledby="featured-tab-crestmont-west">
        <div class="featured-narrative">
          <h3 class="featured-project-name">{first.label}</h3>
          <p class="featured-location">{first.location}</p>
          <p class="featured-view-copy" data-featured-copy>{first.copy}</p>
          <a class="featured-project-link" href={first.href}><span class="featured-link-arrow" aria-hidden="true"><ArrowRight size={22} stroke-width={1.35} /></span><span>View Project</span></a>
        </div>
        <div class="featured-media">
          <a class="featured-photo" href={first.href + '#gallery'} aria-label="View the Crestmont West gallery">
            <img data-featured-image src={first.image} alt={first.alt} width="1920" height="1280" loading="lazy" decoding="async" />
          </a>
          <a class="featured-detail-photo" href={first.href + '#gallery'} aria-label="View Crestmont West detail photographs">
            <img data-featured-detail src={first.detail} alt={first.detailAlt} width="1600" height="1067" loading="lazy" decoding="async" />
          </a>
        </div>
      </div>

    </div>
    <p class="featured-status" role="status" aria-live="polite"></p>
    <script type="application/json" id="featured-view-data" is:inline set:html={JSON.stringify(views).replace(/</g, '\u003c')} />
  </div>
</section>
<script>import '../scripts/featured-project';</script>
