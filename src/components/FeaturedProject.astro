---
import { ArrowRight } from '@lucide/astro';
import { media, projects, projectPath } from '../data/projects';
import '../styles/featured-project.css';
const base=import.meta.env.BASE_URL;
const asset=(src:string)=>base+src.replace(/^\//,'');
const project=projects.find(project=>project.id==='crestmont-west')!;
const href=projectPath(project,base);
const views=[
  {id:'courtyard',label:'Shared Courtyard',image:media.featured,alt:'Shared gravel path with timber seating, planting and natural stone edging at Crestmont West',detail:media.featuredDetail,detailAlt:'Trees and grasses along the planted frontage at Crestmont West',caption:'Planting along the pedestrian frontage.',title:'Shared space, from the doorstep out.',copy:'A planted courtyard, places to sit and play, and paths alongside the homes. The spaces between buildings bring the landscape into everyday use.'},
  {id:'play',label:'Places to Play',image:'/media/gallery/crestmont-west/7.webp',alt:'The shared play area between the homes and commercial frontage at Crestmont West',detail:'/media/gallery/crestmont-west/4.webp',detailAlt:'A low natural stone edge alongside the gravel play space at Crestmont West',caption:'Stone edging beside the shared play space.',title:'Room to play. Places to gather.',copy:'Play equipment and timber seating share the outdoor space. A low stone edge separates the gravel surface from the planted beds.'},
  {id:'planting',label:'Planted Frontage',image:'/media/gallery/crestmont-west/8.webp',alt:'Trees, grasses and flowering plants along the commercial frontage at Crestmont West',detail:'/media/gallery/crestmont-west/5.webp',detailAlt:'A curving path through trees and planting alongside the homes at Crestmont West',caption:'A planted path through the residential landscape.',title:'A landscape that connects.',copy:'Trees, flowering plants and grasses follow the commercial frontage. Within the residential landscape, paths curve through planting to connect the homes and shared spaces.'},
].map(view=>({...view,image:asset(view.image),detail:asset(view.detail)}));
const first=views[0];
---
<section id="featured" class="featured frame" aria-labelledby="featured-title">
  <div class="featured-heading" data-reveal><div><p class="featured-label">Featured Project</p><h2 id="featured-title">Crestmont West</h2></div><a class="text-link" href={href}>View Project <ArrowRight size={20} stroke-width={1.5}/></a></div>
  <div class="featured-views js-only" role="tablist" aria-label="Explore Crestmont West">
    {views.map((view,index)=><button type="button" role="tab" id={'featured-tab-'+view.id} aria-controls="featured-perspective" aria-selected={index===0} tabindex={index===0?0:-1} data-featured-view={view.id}>{view.label}<ArrowRight size={17} stroke-width={1.5}/></button>)}
  </div>
  <div id="featured-perspective" role="tabpanel" aria-labelledby="featured-tab-courtyard">
    <a href={href} class="featured-image" aria-label="View Crestmont West project" data-reveal>
      <img data-featured-image src={first.image} alt={first.alt} width="1920" height="1280" loading="lazy" decoding="async" />
      <span class="featured-image-action">Explore Crestmont West <ArrowRight size={20} stroke-width={1.5}/></span>
    </a>
    <div class="featured-story" data-reveal>
      <div class="featured-information">
        <p class="featured-description" data-featured-title>{first.title}</p>
        <p data-featured-copy>{first.copy}</p>
        <div class="featured-credit"><span>Calgary, Alberta</span><span>Multifamily community · Architecture by Gravity</span></div>
      </div>
      <figure class="featured-secondary">
        <a href={href+'#gallery'} aria-label="Explore the Crestmont West gallery"><img data-featured-detail src={first.detail} alt={first.detailAlt} width="1600" height="1067" loading="lazy" decoding="async" /><ArrowRight class="featured-detail-arrow" size={22} stroke-width={1.5}/></a>
        <figcaption data-featured-caption>{first.caption}</figcaption>
      </figure>
    </div>
  </div>
  <p class="featured-status" role="status" aria-live="polite"></p>
  <script type="application/json" id="featured-view-data" is:inline set:html={JSON.stringify(views).replace(/</g,'\\u003c')}/>
</section>
<script>import '../scripts/featured-project';</script>
