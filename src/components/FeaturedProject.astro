---
import { ArrowLeft, ArrowRight, Pause, Play } from '@lucide/astro';
import { media, projects, projectPath } from '../data/projects';
import '../styles/featured-project.css';
const base = import.meta.env.BASE_URL;
const asset = (src: string) => base + src.replace(/^\//, '');
const project = projects.find(project => project.id === 'crestmont-west')!;
const href = projectPath(project, base);
const views = [
  { id: 'courtyard', label: 'Shared Courtyard', image: media.featured, alt: 'Shared gravel path with timber seating, planting and natural stone edging at Crestmont West', detail: media.featuredDetail, detailAlt: 'Trees, grasses and flowering plants along the frontage at Crestmont West', copy: 'A planted courtyard connects the homes with timber seating, a shared play area, and paths for everyday use.' },
  { id: 'play', label: 'Places to Play', image: '/media/gallery/crestmont-west/7.webp', alt: 'The shared play area between the homes and commercial frontage at Crestmont West', detail: '/media/gallery/crestmont-west/4.webp', detailAlt: 'Natural stone edging and timber play elements in the Crestmont West courtyard', copy: 'Play equipment and timber seating share the courtyard. Natural stone edges separate the gravel play space from the planted beds.' },
  { id: 'planting', label: 'Planted Frontage', image: '/media/gallery/crestmont-west/8.webp', alt: 'Trees, grasses and flowering plants along the commercial frontage at Crestmont West', detail: '/media/gallery/crestmont-west/5.webp', detailAlt: 'A curving path between evergreen planting and the shared play space at Crestmont West', copy: 'Trees, grasses, and flowering plants soften the commercial frontage. Curving paths connect the homes with planted courtyards and shared spaces.' },
].map(view => ({ ...view, image: asset(view.image), detail: asset(view.detail) }));
const first = views[0];
---
<section id="featured" class="featured" aria-labelledby="featured-title">
  <div class="frame featured-inner">
    <h2 id="featured-title">Featured Project</h2>
    <div class="featured-presentation" data-reveal>
      <div class="featured-card" id="featured-perspective" role="tabpanel" aria-labelledby="featured-tab-courtyard">
        <div class="featured-narrative">
          <h3 class="featured-project-name">Crestmont West</h3>
          <p class="featured-location">Calgary, Alberta</p>
          <p class="featured-view-copy" data-featured-copy>{first.copy}</p>
          <a class="featured-project-link" href={href}><span class="featured-link-arrow" aria-hidden="true"><ArrowRight size={22} stroke-width={1.35} /></span><span>View Project</span></a>
        </div>
        <div class="featured-media">
          <a class="featured-photo" href={href + '#gallery'} aria-label="View the Crestmont West gallery">
            <img data-featured-image src={first.image} alt={first.alt} width="1920" height="1280" loading="lazy" decoding="async" />
          </a>
          <a class="featured-detail-photo" href={href + '#gallery'} aria-label="View Crestmont West detail photographs">
            <img data-featured-detail src={first.detail} alt={first.detailAlt} width="1600" height="1067" loading="lazy" decoding="async" />
          </a>
        </div>
      </div>
      <div class="featured-controls js-only">
        <div class="featured-views" role="tablist" aria-label="Explore Crestmont West">
          {views.map((view, index) => <button type="button" role="tab" id={'featured-tab-' + view.id} aria-controls="featured-perspective" aria-selected={index === 0} tabindex={index === 0 ? 0 : -1} data-featured-view={view.id}>{view.label}</button>)}
        </div>
        <div class="featured-paging" role="group" aria-label="Featured project views">
          <button type="button" data-featured-autoplay-toggle aria-label="Pause automatic featured views" aria-controls="featured-perspective"><Pause class="featured-pause-icon" size={17} stroke-width={1.4} /><Play class="featured-play-icon" size={17} stroke-width={1.4} /></button>
          <button type="button" data-featured-previous aria-label="Previous featured view"><ArrowLeft size={23} stroke-width={1.3} /></button>
          <button type="button" data-featured-next aria-label="Next featured view"><ArrowRight size={23} stroke-width={1.3} /></button>
        </div>
      </div>
    </div>
    <p class="featured-status" role="status" aria-live="polite"></p>
    <script type="application/json" id="featured-view-data" is:inline set:html={JSON.stringify(views).replace(/</g, '\u003c')} />
  </div>
</section>
<script>import '../scripts/featured-project';</script>
