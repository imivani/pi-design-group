---
// Search and link-preview tags shared by every page. Share images are 1200 x 630
// photographs made by scripts/build-share-images.mjs; titles and descriptions
// appear beside them in previews, so the images carry no text.
type Props = { title: string; description: string; image?: string; imageAlt?: string; type?: 'website' | 'article'; noindex?: boolean };
const { title, description, image = '/media/share/home.jpg', imageAlt = 'Front gardens and a planted pathway along homes at D’Arcy', type = 'website', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL(Astro.url.origin);
// Pages are served without a trailing slash, matching the sitemap.
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), site).href;
const imageUrl = new URL(base + image.replace(/^\//, ''), site).href;
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
{!noindex && <link rel="canonical" href={canonical} />}
<meta property="og:site_name" content="Pi Design Group" />
<meta property="og:type" content={type} />
<meta property="og:locale" content="en_CA" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
