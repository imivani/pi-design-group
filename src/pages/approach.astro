---
import { ArrowDown, ArrowLeft, ArrowRight, ArrowUpRight, Plus, UsersRound, Network, Layers, Sprout } from '@lucide/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MotionSetup from '../components/MotionSetup.astro';
import SeoMeta from '../components/SeoMeta.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { projects, projectPath, media } from '../data/projects';
import { projectDetails } from '../data/project-details';
import { principles, stages } from '../data/practice';
import { faq } from '../data/faq';
import '../styles/global.css';
import '../styles/services.css';
import '../styles/approach.css';
const base = import.meta.env.BASE_URL;
const asset = (path: string) => base + path.replace(/^\//, '');
const icons = [UsersRound, Network, Layers, Sprout];
// Each pair is a landscape plan and a photograph of the same project, with the
// explanation already written for that project's page.
const pairs = ['crestmont-west', 'darcy', 'evanston', 'seton-crossing'].map(id => {
  const project = projects.find(item => item.id === id)!;
  const { gallery, editorial } = projectDetails(project);
  const detail = editorial!.detail!;
  return { project, title: detail.title, copy: detail.copy, plan: gallery[detail.drawingIndex], built: gallery[detail.photoIndex!] };
});
// Hero: Crestmont West's plan gives way to its built courtyard. The three cards
// follow one landscape from drawing, to detail, to the finished street.
const heroProject = projects.find(project => project.id === 'crestmont-west')!;
const stageCards = [
  { ...stages[0], src: '/media/gallery/darcy/3.webp', alt: 'Overall landscape plan for D’Arcy', drawing: true, copy: 'Site analysis and a clear landscape direction.' },
  { ...stages[1], src: media.featuredDetail, alt: 'Planting and building frontage at Crestmont West', drawing: false, copy: 'Planting, materials and the drawings to build them.' },
  { ...stages[2], src: '/media/gallery/darcy/usb-img_2484.webp', alt: 'Gardens and planted sidewalks connect homes at D’Arcy', drawing: false, copy: 'Approvals, coordination and, where included, construction support.' },
];
// Pictures for the step story (drawing, detail, finished street) and the four principles.
const storyImages = [
  { src: '/media/gallery/darcy/3.webp', caption: 'Landscape plan · D’Arcy', drawing: true },
  { src: media.featuredDetail, caption: 'Planting and frontage · Crestmont West', drawing: false },
  { src: '/media/gallery/darcy/usb-img_2484.webp', caption: 'The built street · D’Arcy', drawing: false },
];
const valueImages = [media.services.multifamily, '/media/gallery/evanston/2.webp', media.services.commercial, '/media/gallery/darcy/usb-img_2490.webp'];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<!doctype html>
<html lang="en" data-motion="full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoMeta title="Our Approach | Pi Design Group" description="How Pi Design Group takes a landscape from the first site visit to construction: reading the place, resolving the detail and bringing it together, with plans and the built work side by side." image="/media/share/contact.jpg" imageAlt="Planting, seating and shared paths at Crestmont West" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <MotionSetup />
  </head>
  <body class="service-page approach-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header darkHero />
    <main id="main">
      <section id="hero" class="approach-hero" aria-labelledby="approach-title" data-hero-view="built">
        <div class="approach-hero-media" aria-hidden="true" data-page-arrive="fade">
          <img class="approach-hero-plan" src={asset(media.drawing)} alt="" width="1536" height="1024" fetchpriority="high" decoding="async" />
          <div class="approach-hero-built"><img src={asset(media.featured)} alt="" width="1920" height="1280" fetchpriority="high" decoding="async" /></div>
          <span class="approach-hero-ground"></span>
          <div class="approach-hero-scrim"></div>
        </div>
        <div class="frame approach-hero-inner">
          <div data-page-arrive style="--arrive:1"><Breadcrumbs class="approach-hero-trail" items={[['Our Approach']]} /></div>
          <h1 id="approach-title"><span data-page-arrive style="--arrive:2">From the first</span> <span data-page-arrive style="--arrive:3">site visit to</span> <span data-page-arrive style="--arrive:4">construction.</span></h1>
          <div class="approach-hero-foot">
            <p class="approach-hero-intro" data-page-arrive style="--arrive:5">One landscape, considered at every scale. We read the place, resolve the detail, then bring it together through documentation, approvals and, where the scope includes it, construction.</p>
            <div class="approach-hero-switch" data-page-arrive style="--arrive:6">
              <div class="approach-toggle approach-toggle--hero" role="group" aria-label="Show the Crestmont West plan or the built courtyard">
                <span class="approach-toggle-pill" aria-hidden="true"></span>
                <button type="button" data-hero-show="plan" aria-pressed="false">Plan</button>
                <button type="button" data-hero-show="built" aria-pressed="true">Built</button>
              </div>
              <a class="approach-hero-caption" href={projectPath(heroProject, base)}><span data-hero-caption>Built courtyard · Crestmont West</span><ArrowUpRight size={16} stroke-width={1.4} aria-hidden="true" /></a>
            </div>
          </div>
        </div>
      </section>
      <!-- With full motion the hero opens on the plan before the first paint; the built courtyard then rises into place. -->
      <script is:inline>if(document.documentElement.dataset.motion==='full')document.querySelector('#hero').dataset.heroView='plan';</script>

      <nav class="approach-steps frame" aria-label="Project stages">
        <ol>
          {stageCards.map((card, index) => <li data-page-arrive data-arrive-last={index === stageCards.length - 1 ? '' : undefined} style={`--arrive:${index + 6}`}>
            <a href={'#stage-' + (index + 1)}>
              <span class:list={['approach-steps-photo', { 'is-drawing': card.drawing }]}><img src={asset(card.src)} alt={card.alt} width="1200" height="1500" loading="eager" decoding="async" /></span>
              <span class="approach-steps-label"><em>{String(index + 1).padStart(2, '0')}</em> {card.label}</span>
              <span class="approach-steps-title">{card.title}<ArrowDown size={18} stroke-width={1.4} aria-hidden="true" /></span>
              <span class="approach-steps-copy">{card.copy}</span>
            </a>
          </li>)}
        </ol>
      </nav>

      <section class="approach-story frame" aria-labelledby="stages-title" data-story>
        <div class="approach-story-media" aria-hidden="true">
          <div class="approach-story-frame">
            {storyImages.map((image, index) => <figure data-story-image={index} data-caption={image.caption} class:list={{ 'is-drawing': image.drawing }} data-active={String(index === 0)}><img src={asset(image.src)} alt="" width="1200" height="1500" loading="lazy" decoding="async" /></figure>)}
            <span class="approach-story-count"><span data-story-count>01</span><small>/ 03</small></span>
            <span class="approach-story-progress"><span data-story-progress></span></span>
          </div>
          <p class="approach-story-caption" data-story-caption>{storyImages[0].caption}</p>
        </div>
        <div class="approach-story-steps">
          <h2 id="stages-title" class="approach-eyebrow">What each step includes</h2>
          <ol>
            {stages.map((stage, index) => <li id={'stage-' + (index + 1)} class="approach-story-step" data-story-step={index} data-active={String(index === 0)}>
              <span class="approach-story-number">{String(index + 1).padStart(2, '0')}</span>
              <p class="approach-label">{stage.label}</p>
              <h3>{stage.title}</h3>
              <figure class="approach-story-inline" aria-hidden="true"><img src={asset(storyImages[index].src)} alt="" width="1200" height="900" loading="lazy" decoding="async" /></figure>
              <ul>{stage.items.map(([title, copy]) => <li><strong>{title}</strong><span>{copy}</span></li>)}</ul>
            </li>)}
          </ol>
        </div>
      </section>

      <section class="approach-plates" aria-labelledby="pairs-title">
        <div class="frame approach-plates-head">
          <div>
            <p class="approach-eyebrow">Plan to ground</p>
            <h2 id="pairs-title">Every landscape starts on paper.</h2>
          </div>
          <div class="approach-plates-controls">
            <span class="approach-plates-count"><span data-plates-count>01</span> / {String(pairs.length).padStart(2, '0')}</span>
            <button type="button" data-plates-prev aria-label="Previous project"><ArrowLeft size={20} stroke-width={1.4} aria-hidden="true" /></button>
            <button type="button" data-plates-next aria-label="Next project"><ArrowRight size={20} stroke-width={1.4} aria-hidden="true" /></button>
          </div>
        </div>
        <div class="approach-plates-track" data-plates-track data-spring-reveal="children" tabindex="0" aria-label="Plans and built projects, scroll sideways">
          {pairs.map((pair, index) => <article class="approach-plate" data-pair data-view="built" aria-labelledby={'pair-' + index}>
            <span class="approach-plate-numeral" aria-hidden="true">{index + 1}</span>
            <div class="approach-plate-sheets">
              <figure data-layer="plan" class="approach-sheet approach-sheet--plan"><img src={asset(pair.plan.src)} alt={pair.plan.caption} width={pair.plan.width} height={pair.plan.height} loading="lazy" decoding="async" /></figure>
              <figure data-layer="built" class="approach-sheet approach-sheet--built"><img src={asset(pair.built.src)} alt={pair.built.caption} width={pair.built.width} height={pair.built.height} loading="lazy" decoding="async" /></figure>
              <div class="approach-toggle approach-toggle--plate" role="group" aria-label={'Show the ' + pair.project.name + ' plan or the built project'}>
                <span class="approach-toggle-pill" aria-hidden="true"></span>
                <button type="button" data-show="plan" aria-pressed="false">Plan</button>
                <button type="button" data-show="built" aria-pressed="true">Built</button>
              </div>
            </div>
            <div class="approach-plate-copy">
              <p class="approach-label">{pair.project.name}{pair.project.location && ' · ' + pair.project.location}</p>
              <h3 id={'pair-' + index}>{pair.title}</h3>
              <p>{pair.copy}</p>
              <a class="text-link" href={projectPath(pair.project, base)} data-project-card={pair.project.id}>View the project <ArrowUpRight size={18} stroke-width={1.4} aria-hidden="true" /></a>
            </div>
          </article>)}
        </div>
        <div class="frame"><span class="approach-plates-bar"><span data-plates-bar></span></span></div>
      </section>

      <section class="approach-values" aria-labelledby="principles-title">
        <div class="frame">
          <p class="approach-eyebrow" id="principles-title">How we work</p>
          <ul class="approach-values-list" data-spring-reveal="children">
            {principles.map(([title, copy], index) => { const Icon = icons[index]; return <li class="approach-value" tabindex="0">
              <span class="approach-value-photo" aria-hidden="true"><img src={asset(valueImages[index])} alt="" width="1600" height="900" loading="lazy" decoding="async" /></span>
              <span class="approach-value-number">{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p><Icon size={22} stroke-width={1.3} aria-hidden="true" />{copy}</p>
            </li>; })}
          </ul>
        </div>
      </section>

      <section class="approach-faq frame" aria-labelledby="faq-title">
        <div class="approach-faq-aside">
          <p class="approach-eyebrow">Questions</p>
          <h2 id="faq-title">Before you call.</h2>
          <a class="approach-faq-person" href={base + 'contact'}>
            <img src={asset('/media/people/peter-imshenetskyy-portrait.webp')} alt="Peter Imshenetskyy" width="900" height="1125" loading="lazy" decoding="async" />
            <span><strong>Still unsure? Ask Peter.</strong><span>Principal · 403-510-4071</span></span>
            <ArrowUpRight size={18} stroke-width={1.4} aria-hidden="true" />
          </a>
        </div>
        <div class="approach-faq-list" data-spring-reveal="children">
          {faq.map(([question, answer], index) => <details class="approach-question"><summary><span class="approach-question-number">{String(index + 1).padStart(2, '0')}</span><span class="approach-question-text">{question}</span><Plus size={22} stroke-width={1.3} aria-hidden="true" /></summary><div class="approach-answer"><p>{answer}</p></div></details>)}
        </div>
      </section>

      <section class="approach-finale" aria-labelledby="close-title">
        <img class="approach-finale-photo" src={asset('/media/gallery/darcy/usb-img_2490.webp')} alt="" width="1600" height="1067" loading="lazy" decoding="async" />
        <div class="approach-finale-scrim" aria-hidden="true"></div>
        <div class="frame approach-finale-inner">
          <h2 id="close-title" data-spring-reveal="children"><span>Have a site</span> <span>in mind?</span></h2>
          <a class="approach-finale-button" href={base + 'contact'} data-finale-button><span>Start a conversation</span><ArrowUpRight size={26} stroke-width={1.3} aria-hidden="true" /></a>
          <p class="approach-finale-direct"><a href="mailto:peter@pidesigngroup.ca">peter@pidesigngroup.ca</a><a href="tel:+14035104071">403-510-4071</a></p>
        </div>
      </section>
    </main>
    <Footer />
    <script>import '../scripts/approach';</script>
  </body>
</html>
