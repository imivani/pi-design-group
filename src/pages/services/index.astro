---
import { ArrowRight } from '@lucide/astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MotionSetup from '../../components/MotionSetup.astro';
import SeoMeta from '../../components/SeoMeta.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { services, servicePath } from '../../data/services';
import '../../styles/global.css';
import '../../styles/services.css';
const base = import.meta.env.BASE_URL;
const asset = (path: string) => base + path.replace(/^\//, '');
---
<!doctype html>
<html lang="en" data-motion="full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoMeta title="Services | Pi Design Group" description="Landscape architecture for multifamily communities, commercial plazas, and the play and open spaces that connect them. Based in Calgary, Alberta." image="/media/share/service-multifamily.jpg" imageAlt={services[0].alt} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <MotionSetup />
  </head>
  <body class="service-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <section class="service-hero frame" aria-labelledby="services-title">
        <Breadcrumbs items={[['Services']]} />
        <div class="service-title-row">
          <h1 id="services-title" data-service-arrive>Services</h1>
          <p class="service-intro" data-service-arrive>Landscape architecture in three areas, from the first site visit to construction. Each one connects planting, paths and the places people gather.</p>
        </div>
        <ul class="service-index-grid">
          {services.map((service, index) => <li data-service-arrive>
            <a href={servicePath(service, base)}>
              <span class="service-index-photo"><img src={asset(service.image)} alt={service.alt} width="1600" height="1067" fetchpriority={index === 0 ? 'high' : undefined} decoding="async" /></span>
              <span class="service-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="service-other-name">{service.name}<ArrowRight size={21} stroke-width={1.4} aria-hidden="true" /></span>
              <span class="service-other-copy">{service.homeCopy}</span>
            </a>
          </li>)}
        </ul>
      </section>
    </main>
    <Footer />
    <script>import '../../scripts/services';</script>
  </body>
</html>
