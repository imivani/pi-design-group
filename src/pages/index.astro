---
import Header from '../components/Header.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import HomeDetails from '../components/HomeDetails.astro';
import ContactPanel from '../components/ContactPanel.astro';
import PracticeIntro from '../components/PracticeIntro.astro';
import ProjectArchive from '../components/ProjectArchive.astro';
import { ArrowRight, ArrowDown, Building, Store, Trees } from '@lucide/astro';
import { media } from '../data/projects';
import { services as serviceData, servicePath } from '../data/services';
import Footer from '../components/Footer.astro';
import MotionSetup from '../components/MotionSetup.astro';
import SeoMeta from '../components/SeoMeta.astro';
import '../styles/global.css';
import '../styles/home-return.css';


const base = import.meta.env.BASE_URL;
const asset = (path: string) => base + path.replace(/^\//, '');
const icons = { multifamily: Building, commercial: Store, parks: Trees };
const services = serviceData.map(service => ({ ...service, icon: icons[service.id], title: service.name, copy: service.homeCopy }));
// Business details for search results, taken from the contact details shown on the site.
const organization = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'Pi Design Group',
  description: 'Landscape architecture and planning practice based in Calgary, Alberta.',
  url: new URL(base, Astro.site).href, image: new URL(base + 'media/share/home.jpg', Astro.site).href,
  email: 'peter@pidesigngroup.ca', telephone: '+1-403-510-4071',
  address: { '@type': 'PostalAddress', addressLocality: 'Calgary', addressRegion: 'AB', addressCountry: 'CA' },
};
---
<!doctype html>
<html lang="en" data-motion="full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoMeta title="Pi Design Group | Landscape architecture" description="Pi Design Group is a Calgary landscape architecture practice designing multifamily communities, commercial plazas and the play and open spaces within them. Explore our complete project collection." />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organization)} />
    <meta name="theme-color" content="#262b2d" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" as="image" href={asset(media.heroPoster)} fetchpriority="high" />
    <MotionSetup />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header homepage />
    <main id="main">
      <section class="hero" id="hero" aria-labelledby="hero-title">
        <div class="hero-media" aria-hidden="true">
          <img class="hero-poster" src={asset(media.heroPoster)} alt="" width="1920" height="1080" fetchpriority="high" />
          <video id="hero-video" data-src={asset(media.heroVideo)} data-src-phone={asset(media.heroVideoPhone)} poster={asset(media.heroPoster)} muted loop playsinline preload="none" tabindex="-1"></video>
          <div class="hero-scrim"></div>
        </div>
        <div class="hero-rails frame" aria-hidden="true"></div>
        <div class="hero-main frame">
          <div class="hero-copy">
            <div class="hero-discipline"><span></span>Landscape Architecture</div>
            <h1 id="hero-title"><span>Shaping Places</span><span>People Belong.</span></h1>
            <p>Landscape design for multifamily communities,<br class="desktop-break" /> commercial plazas, and the open spaces that connect them.</p>
            <a class="outline-button" href="#projects">Explore Our Work <ArrowRight size={19} stroke-width={1.4} /></a>
          </div>
          <span id="video-status" class="sr-only" role="status"></span>
        </div>
        <a href="#about" class="scroll-link" aria-label="Meet Pi Design Group"><ArrowDown size={21} stroke-width={1.3} /></a>
      </section>

      <PracticeIntro />

      <section id="services" class="services frame" aria-labelledby="services-title" tabindex="-1">
        <h2 id="services-title" data-reveal>Our Expertise in Three Areas.</h2>
        <div class="service-gallery" data-active="multifamily" data-reveal>
          {services.map((service, i) => (
            <article class="service-panel" data-service-panel={service.id} data-active={String(i === 0)}>
              <img class="service-photo" src={asset(service.image)} alt={service.alt} width="1600" height="1067" loading="lazy" decoding="async" />
              <div class="service-shade" aria-hidden="true"></div>
              <div class="service-information">
                <h3><button type="button" id={'tab-' + service.id} class="service-selector" aria-expanded="true" aria-controls={'service-' + service.id} data-service={service.id}>
                  <span class="service-title"><service.icon size={24} stroke-width={1.3} aria-hidden="true"/>{service.title}</span><ArrowRight size={24} stroke-width={1.3} aria-hidden="true" />
                </button></h3>
                <div class="service-description" id={'service-' + service.id} role="region" aria-labelledby={'tab-' + service.id}>
                  <div><p>{service.copy}</p><a class="service-page-link" href={servicePath(service, base)}>Explore {service.title} <ArrowRight size={18} stroke-width={1.4} aria-hidden="true" /></a><span class="service-caption">{service.caption}</span><span class="service-error" role="status"></span></div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <HomeDetails />

      <FeaturedProject />

      <ProjectArchive />

      <ContactPanel />
    </main>
    <Footer homepage />
    <script>
      import '../scripts/home-return';
      import '../scripts/site';
    </script>
  </body>
</html>
