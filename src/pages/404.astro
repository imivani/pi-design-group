---
import { ArrowRight, ArrowUpRight, Search } from '@lucide/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MotionSetup from '../components/MotionSetup.astro';
import SeoMeta from '../components/SeoMeta.astro';
import { projects, projectPath } from '../data/projects';
import '../styles/global.css';
import '../styles/not-found.css';
const base = import.meta.env.BASE_URL;
const asset = (path: string) => base + path.replace(/^\//, '');
const suggestions = ['crestmont-west', 'darcy', 'seton-crossing'].map(id => projects.find(project => project.id === id)!);
---
<!doctype html>
<html lang="en" data-motion="full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoMeta title="Page not found | Pi Design Group" description="This page couldn’t be found. Browse Pi Design Group’s landscape projects or get in touch." noindex />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <MotionSetup />
  </head>
  <body class="not-found-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <section class="not-found frame" aria-labelledby="not-found-title">
        <div class="not-found-intro">
          <p class="not-found-kicker" data-not-found-arrive>Error 404</p>
          <h1 id="not-found-title" data-not-found-arrive>We couldn’t find<br />that page.</h1>
          <p class="not-found-copy" data-not-found-arrive>The link you followed may be broken, or the page may have moved. Every project is still here.</p>
          <a class="not-found-search" href={base + '#projects'} data-project-search data-not-found-arrive><Search size={20} stroke-width={1.5} aria-hidden="true" /><span>Search all {projects.length} projects</span></a>
          <div class="not-found-actions" data-not-found-arrive>
            <a class="not-found-home" href={base}><span>Back to Home</span><ArrowRight size={21} stroke-width={1.4} aria-hidden="true" /></a>
            <a class="text-link" href={base + 'contact'}>Contact Us <ArrowUpRight size={19} stroke-width={1.4} aria-hidden="true" /></a>
          </div>
        </div>
        <div class="not-found-places">
          <h2 data-not-found-arrive>A few places to start</h2>
          <ul>
            {suggestions.map(project => <li data-not-found-arrive>
              <a class="not-found-place" href={projectPath(project, base)}>
                <span class="not-found-photo"><img src={asset(project.image)} alt="" width="1200" height="800" loading="lazy" decoding="async" /></span>
                <span class="not-found-name">{project.name}<ArrowUpRight size={19} stroke-width={1.4} aria-hidden="true" /></span>
                <span class="not-found-meta">{[project.type, project.location].filter(Boolean).join(' · ')}</span>
              </a>
            </li>)}
          </ul>
        </div>
      </section>
    </main>
    <Footer />
    <script>import '../scripts/not-found';</script>
  </body>
</html>
